# API
# Hosted alpha services must run with production startup safeguards.
# NODE_ENV=production
# Replay ingest alone accepts larger deterministic timelines; all other routes
# keep Fastify's smaller default body limit. Allowed range: 1 MiB to 64 MiB.
# REPLAY_INGEST_BODY_LIMIT_BYTES=8388608
# Durable source/account upload throttles and per-account active archive quotas.
# REPLAY_INGEST_RATE_LIMIT_SOURCE_MAX_ATTEMPTS=40
# REPLAY_INGEST_RATE_LIMIT_SOURCE_WINDOW_SECONDS=3600
# REPLAY_INGEST_RATE_LIMIT_ACCOUNT_MAX_ATTEMPTS=20
# REPLAY_INGEST_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=3600
# REPLAY_MAX_ACTIVE_ARCHIVES_PER_ACCOUNT=200
# REPLAY_MAX_ACTIVE_BYTES_PER_ACCOUNT=268435456
# Local Docker Postgres default:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gravity_well
# `npm run api:local` always uses this local-only target instead of DATABASE_URL.
LOCAL_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/gravity_well
# Optional Redis connection used by ops backup/drill workflows:
# REDIS_URL=redis://localhost:6379
# Neon example:
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>/<db>?sslmode=require
# API-targeting smokes require these values independently of API_BASE_URL and
# verify them against /readyz before taking any action. Hosted targets require HTTPS.
# SMOKE_EXPECT_API_HOSTNAME=127.0.0.1
# SMOKE_EXPECT_DATABASE_ID=local
# SMOKE_EXPECT_DEPLOYMENT_ENVIRONMENT=development
# SMOKE_TARGET_REQUEST_TIMEOUT_MS=5000
# Smoke tests refuse remote/unreported database targets unless this is explicitly set for isolated staging.
# ALLOW_REMOTE_DATABASE_SMOKE=false
API_PORT=8787
# Immutable release identity reported by /health and /readyz. Render supplies
# RENDER_GIT_COMMIT automatically; set the other two values per service.
# RENDER_GIT_COMMIT=full_40_character_commit_sha
# RELEASE_SHA=dev-local
# DEPLOYMENT_ENVIRONMENT=canary
# DEPLOYMENT_DATABASE_ID=gravity-well-canary
# Signed API sessions. Production refuses to start without a 32+ character secret.
# AUTH_SESSION_SECRET=replace_with_at_least_32_random_characters
# During a planned rotation only, set this to the retired key for no longer than
# AUTH_SESSION_TTL_SECONDS, then remove it after every old session has expired.
# AUTH_SESSION_PREVIOUS_SECRET=replace_with_the_retired_32_plus_character_secret
# AUTH_SESSION_TTL_SECONDS=43200
# Optional separate HMAC secret for pseudonymized auth rate-limit buckets. Falls
# back to AUTH_SESSION_SECRET, but a distinct 32+ character value is preferred.
# AUTH_RATE_LIMIT_SECRET=replace_with_a_distinct_32_plus_character_secret
# Trust exactly this many reverse-proxy hops before using X-Forwarded-For for
# source throttles. Leave unset for direct/local connections.
# API_TRUST_PROXY_HOPS=1
# Emergency identity-link/lookup routes are disabled unless this is configured.
# AUTH_IDENTITY_ADMIN_KEY=replace_with_a_distinct_32_plus_character_admin_key
# Durable auth throttle defaults; tune only from observed alpha operations.
# AUTH_RATE_LIMIT_GLOBAL_SOURCE_MAX_ATTEMPTS=60
# AUTH_RATE_LIMIT_GLOBAL_SOURCE_WINDOW_SECONDS=900
# AUTH_RATE_LIMIT_GUEST_SOURCE_MAX_ATTEMPTS=20
# AUTH_RATE_LIMIT_GUEST_SOURCE_WINDOW_SECONDS=3600
# AUTH_RATE_LIMIT_WEB_SIGNUP_SOURCE_MAX_ATTEMPTS=10
# AUTH_RATE_LIMIT_WEB_SIGNUP_SOURCE_WINDOW_SECONDS=3600
# AUTH_RATE_LIMIT_WEB_SIGNUP_PRINCIPAL_MAX_ATTEMPTS=3
# AUTH_RATE_LIMIT_WEB_SIGNUP_PRINCIPAL_WINDOW_SECONDS=3600
# AUTH_RATE_LIMIT_WEB_SIGNIN_PRINCIPAL_MAX_ATTEMPTS=8
# AUTH_RATE_LIMIT_WEB_SIGNIN_PRINCIPAL_WINDOW_SECONDS=900
# AUTH_RATE_LIMIT_STEAM_SOURCE_MAX_ATTEMPTS=20
# AUTH_RATE_LIMIT_STEAM_SOURCE_WINDOW_SECONDS=300
# AUTH_RATE_LIMIT_STEAM_TICKET_MAX_ATTEMPTS=3
# AUTH_RATE_LIMIT_STEAM_TICKET_WINDOW_SECONDS=300
# AUTH_RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=900
# Local-only escape hatch for old tools. The API refuses to start with this enabled in any hosted deployment.
# ALLOW_INSECURE_ACCOUNT_HEADER=false
# Optional host-managed port fallback (for PaaS platforms):
# PORT=8787
# Browser CORS allowlist (comma-separated origins):
# API_CORS_ORIGINS=http://localhost:5173,https://play.gravitywell.space
# Optional matchmaking timings (seconds):
# MATCHMAKING_TICKET_TTL_SECONDS=90
# MATCHMAKING_SESSION_TTL_SECONDS=1800
# MATCHMAKING_SESSION_TOKEN_TTL_SECONDS=1800
# Controlled-alpha audit accepts 9-120 seconds; 20 is the default.
# MATCHMAKING_RECONNECT_GRACE_SECONDS=20
# MATCHMAKING_HEARTBEAT_INTERVAL_SECONDS=5
# MATCHMAKING_HEARTBEAT_TIMEOUT_SECONDS=30
# MATCHMAKING_CLOSED_RETENTION_SECONDS=120
# MATCHMAKING_SNAPSHOT_INTERVAL_MS=5000
# MATCHMAKING_RUNTIME_NAMESPACE=development
# MATCHMAKING_RUNTIME_LOCK_TIMEOUT_MS=5000
# MATCHMAKING_MAX_RESIDENT_TICKETS=64
# MATCHMAKING_RANKED_INITIAL_GAP=120
# MATCHMAKING_RANKED_GAP_EXPANSION_PER_SECOND=8
# MATCHMAKING_RANKED_MAX_GAP=700
# MATCHMAKING_MASTER_INITIAL_GAP=80
# MATCHMAKING_MASTER_GAP_EXPANSION_PER_SECOND=5
# MATCHMAKING_MASTER_MAX_GAP=400
# MATCHMAKING_MASTER_STRICT_REGION_SECONDS=20
# Controlled alpha entry. Production defaults to closed when mode is omitted.
# MATCHMAKING_ACCESS_MODE=allowlist
# MATCHMAKING_ALPHA_ACCOUNT_IDS=11111111-1111-4111-8111-111111111111,22222222-2222-4222-8222-222222222222
# MATCHMAKING_ALPHA_BUILD_VERSIONS=alpha-commit-sha
# Exact rulesets accepted by the ranked replay verifier.
# RANKED_SUPPORTED_RULESET_VERSIONS=prototype-2026.02
# Durable proof replay throttles. Account+session buckets are participant-specific,
# so one peer cannot consume the other peer's settlement path.
# RANKED_PROOF_RATE_LIMIT_ACCOUNT_SESSION_MAX_ATTEMPTS=4
# RANKED_PROOF_RATE_LIMIT_ACCOUNT_SESSION_WINDOW_SECONDS=600
# RANKED_PROOF_RATE_LIMIT_ACCOUNT_HOUR_MAX_ATTEMPTS=20
# RANKED_PROOF_RATE_LIMIT_ACCOUNT_HOUR_WINDOW_SECONDS=3600
# NAT traversal and telemetry:
# MATCHMAKING_STUN_URLS=stun:stun.l.google.com:19302
# MATCHMAKING_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# Preferred for staging/production: coturn-compatible short-lived credentials.
# MATCHMAKING_TURN_SHARED_SECRET=replace_with_32_plus_random_characters
# MATCHMAKING_TURN_CREDENTIAL_TTL_SECONDS=600
# Local compatibility only; do not use a permanent shared player credential for an online alpha.
# MATCHMAKING_TURN_USERNAME=turn_user
# MATCHMAKING_TURN_CREDENTIAL=turn_pass
# MATCHMAKING_ICE_TRANSPORT_POLICY=all
# MATCHMAKING_FALLBACK_POLICY=relay
# MATCHMAKING_DIRECT_CONNECT_TIMEOUT_MS=8000
# MATCHMAKING_SIGNAL_TTL_SECONDS=600
# MATCHMAKING_SIGNAL_CLEANUP_INTERVAL_SECONDS=60
# MATCHMAKING_SIGNAL_MAX_MESSAGES_PER_SESSION=512
# MATCHMAKING_SIGNAL_MAX_BYTES_PER_SESSION=2097152
# MATCHMAKING_SIGNAL_MAX_MESSAGES_PER_SENDER=256
# MATCHMAKING_SIGNAL_MAX_BYTES_PER_SENDER=1048576
# RANKED_TERMINAL_DECISION_PROCESS_INTERVAL_MS=1000
# MATCHMAKING_TELEMETRY_RETENTION_MS=86400000
# Private rooms:
# ROOM_IDLE_TIMEOUT_SECONDS=900
# ROOM_CLOSED_RETENTION_SECONDS=1800
# ROOM_MAX_PARTICIPANTS=2
# ROOM_MAX_SPECTATORS=4
# ROOM_MAX_HISTORY_ENTRIES=20
# ROOM_WEB_INVITE_BASE_URL=http://localhost:5173
# Steam web-ticket verification. Tickets must come from GetAuthTicketForWebApi
# with the same identity string. Dev tickets are disabled in production.
# STEAM_APP_ID=0
# STEAM_WEB_API_KEY=replace_with_publisher_web_api_key
# STEAM_WEB_API_IDENTITY=gravity-well-api
# STEAM_WEB_API_BASE=https://partner.steam-api.com
# STEAM_WEB_API_TIMEOUT_MS=5000
# STEAM_ALLOW_DEV_TICKETS=true
# Presence + friend invites:
# PRESENCE_TTL_MS=300000
# PRESENCE_RATE_WINDOW_MS=30000
# PRESENCE_MAX_UPDATES_PER_WINDOW=12
# FRIEND_INVITE_TTL_MS=90000
# FRIEND_INVITE_RATE_WINDOW_MS=60000
# FRIEND_INVITE_MAX_PER_WINDOW=5
# Replay archive:
# Use `local` for development. Controlled alpha uses `postgres` so payloads
# survive API deploys without requiring a separate object-storage provider.
# REPLAY_BLOB_PROVIDER=local
# REPLAY_BLOB_DIR=./data/replay-blobs
# REPLAY_RETENTION_DAYS_RANKED=365
# REPLAY_RETENTION_DAYS_CASUAL=90
# REPLAY_RETENTION_CLEANUP_INTERVAL_SECONDS=3600
# Ranked seasons:
# RANKED_SEASON_DURATION_DAYS=90
# RANKED_SEASON_RESET_ADMIN_KEY=replace_with_strong_admin_key
# RANKED_CALIBRATION_MATCHES=5
# RANKED_MASTER_ENTRY_RATING=1900
# RANKED_MASTER_BASE_POINTS=1500
# RANKED_MR_WEIGHT_RANKED=1
# Ranked anomaly detection:
# RANKED_ANOMALY_MIN_MATCH_INTERVAL_SECONDS=30
# RANKED_ANOMALY_RATING_JUMP_THRESHOLD=60
# RANKED_ANOMALY_MR_JUMP_THRESHOLD=80
# RANKED_ANOMALY_ADMIN_KEY=replace_with_strong_anomaly_admin_key
# Enforcement tooling:
# ENFORCEMENT_ADMIN_KEY=replace_with_strong_enforcement_admin_key
# SLO and alerting:
# SLO_ADMIN_KEY=replace_with_strong_slo_admin_key
# SLO_AVAILABILITY_TARGET_PERCENT=99.5
# SLO_ERROR_RATE_TARGET_PERCENT=1
# SLO_LATENCY_P95_TARGET_MS=350
# SLO_REPORT_WINDOW_DAYS=7
# Request samples retain the smaller of this age window and newest-row cap.
# SLO_SAMPLE_RETENTION_DAYS=14
# SLO_SAMPLE_MAX_ROWS=250000
# SLO_SAMPLE_CLEANUP_INTERVAL_SECONDS=300
# Safe rollout health-gate:
# API_BASE_URL=https://api.gravitywell.space
# API_SLO_ADMIN_KEY=replace_with_slo_admin_key
# API_OPS_ADMIN_KEY=replace_with_slo_admin_key
# DEPLOY_HEALTHCHECK_WINDOW_HOURS=1
# DEPLOY_MAX_CRITICAL_ALERTS=0
# DEPLOY_MAX_WARNING_ALERTS=1
# DEPLOY_MAX_ACTIVE_SESSIONS=0
# DEPLOY_DRAIN_TIMEOUT_SECONDS=180
# DEPLOY_DRAIN_POLL_INTERVAL_MS=2000
# DEPLOY_ALLOW_LEGACY_NO_DRAIN=false
# DEPLOY_REQUIRE_TURN=false
# DEPLOY_REQUIRE_ALPHA_ALLOWLIST=true
# DEPLOY_REQUIRE_ADMIN_CHECKS=false
# DEPLOY_REQUIRE_DURABLE_REPLAY_STORE=false
# DEPLOY_EXPECT_RELEASE_SHA=full_40_character_commit_sha
# DEPLOY_EXPECT_MIGRATION_HEAD=030_matchmaking_runtime_fences.sql
# DEPLOY_EXPECT_MIGRATION_COUNT=30
# DEPLOY_EXPECT_DATABASE_TARGET=remote
# DEPLOY_EXPECT_DATABASE_ID=gravity-well-canary
# DEPLOY_EXPECT_ENVIRONMENT=canary
# DEPLOY_EXPECT_MATCHMAKING_RUNTIME_NAMESPACE=canary
# DEPLOY_EXPECT_MAX_RESIDENT_TICKETS=64

# Web client
VITE_PLATFORM=web
VITE_PROFILE_API_BASE=http://localhost:8787
# VITE_MATCHMAKING_API_BASE=http://localhost:8787
# Steam shell builds must use the exact same identity configured as
# STEAM_WEB_API_IDENTITY on the API. Never embed the publisher API key.
# VITE_STEAM_WEB_API_IDENTITY=gravity-well-api
# Development only; production builds ignore this without an explicit dev allowance.
# VITE_STEAM_DEV_TICKET=dev-steam:76561198012345678

# Runtime profile and feature flags
# VITE_APP_ENV defaults to vite MODE when omitted.
VITE_APP_ENV=development
# Optional per-feature overrides:
# VITE_FEATURE_ONLINE=true
# VITE_FEATURE_RANKED=true
# Enables matched sessions to enter WebRTC/DataChannel rollback gameplay. Required
# for a functional allow-listed online alpha, even while public entry stays closed.
# VITE_FEATURE_ONLINE_MATCH_RUNTIME=true
# VITE_FEATURE_DEBUG_TOOLS=true
# VITE_FEATURE_ONLINE_DIAGNOSTICS=true
# VITE_FEATURE_TRAINING_MODE=true
# VITE_FEATURE_ARCADE_MODE=true
# VITE_FEATURE_ONLINE_DEV_MENU=true
# VITE_FEATURE_ROLLBACK_SCAFFOLD=true
# Optional diagnostics export metadata:
# VITE_APP_BUILD=dev-local
# VITE_RULESET_VERSION=prototype-2026.02
# VITE_BALANCE_PROFILE_ID=default
