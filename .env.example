# API
# Local Docker Postgres default:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gravity_well
# Neon example:
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>/<db>?sslmode=require
API_PORT=8787
# Optional host-managed port fallback (for PaaS platforms):
# PORT=8787
# Browser CORS allowlist (comma-separated origins):
# API_CORS_ORIGINS=http://localhost:5173,https://play.gravitywell.space
# Optional matchmaking timings (seconds):
# MATCHMAKING_TICKET_TTL_SECONDS=90
# MATCHMAKING_SESSION_TTL_SECONDS=30
# MATCHMAKING_SESSION_TOKEN_TTL_SECONDS=30
# MATCHMAKING_RECONNECT_GRACE_SECONDS=10
# MATCHMAKING_CLOSED_RETENTION_SECONDS=120
# MATCHMAKING_RANKED_INITIAL_GAP=120
# MATCHMAKING_RANKED_GAP_EXPANSION_PER_SECOND=8
# MATCHMAKING_RANKED_MAX_GAP=700
# MATCHMAKING_MASTER_INITIAL_GAP=80
# MATCHMAKING_MASTER_GAP_EXPANSION_PER_SECOND=5
# MATCHMAKING_MASTER_MAX_GAP=400
# MATCHMAKING_MASTER_STRICT_REGION_SECONDS=20
# NAT traversal and telemetry:
# MATCHMAKING_STUN_URLS=stun:stun.l.google.com:19302
# MATCHMAKING_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# MATCHMAKING_TURN_USERNAME=turn_user
# MATCHMAKING_TURN_CREDENTIAL=turn_pass
# MATCHMAKING_ICE_TRANSPORT_POLICY=all
# MATCHMAKING_FALLBACK_POLICY=relay
# MATCHMAKING_DIRECT_CONNECT_TIMEOUT_MS=1800
# MATCHMAKING_TELEMETRY_RETENTION_MS=86400000
# Private rooms:
# ROOM_IDLE_TIMEOUT_SECONDS=900
# ROOM_CLOSED_RETENTION_SECONDS=1800
# ROOM_MAX_PARTICIPANTS=2
# ROOM_MAX_SPECTATORS=4
# ROOM_MAX_HISTORY_ENTRIES=20
# ROOM_WEB_INVITE_BASE_URL=http://localhost:5173
# STEAM_APP_ID=0
# Presence + friend invites:
# PRESENCE_TTL_MS=300000
# PRESENCE_RATE_WINDOW_MS=30000
# PRESENCE_MAX_UPDATES_PER_WINDOW=12
# FRIEND_INVITE_TTL_MS=90000
# FRIEND_INVITE_RATE_WINDOW_MS=60000
# FRIEND_INVITE_MAX_PER_WINDOW=5
# Replay archive:
# REPLAY_BLOB_PROVIDER=local
# REPLAY_BLOB_DIR=./data/replay-blobs
# REPLAY_RETENTION_DAYS_RANKED=365
# REPLAY_RETENTION_DAYS_CASUAL=90
# Ranked seasons:
# RANKED_SEASON_DURATION_DAYS=90
# RANKED_SEASON_RESET_ADMIN_KEY=replace_with_strong_admin_key
# RANKED_CALIBRATION_MATCHES=5
# RANKED_MASTER_ENTRY_RATING=1900
# RANKED_MASTER_BASE_POINTS=1500
# RANKED_MR_WEIGHT_RANKED=1
# Ranked anomaly detection:
# RANKED_ANOMALY_MIN_MATCH_INTERVAL_SECONDS=30
# RANKED_ANOMALY_RATING_JUMP_THRESHOLD=60
# RANKED_ANOMALY_MR_JUMP_THRESHOLD=80
# RANKED_ANOMALY_ADMIN_KEY=replace_with_strong_anomaly_admin_key
# Enforcement tooling:
# ENFORCEMENT_ADMIN_KEY=replace_with_strong_enforcement_admin_key

# Web client
VITE_PLATFORM=web
VITE_PROFILE_API_BASE=http://localhost:8787
# VITE_MATCHMAKING_API_BASE=http://localhost:8787

# Runtime profile and feature flags
# VITE_APP_ENV defaults to vite MODE when omitted.
VITE_APP_ENV=development
# Optional per-feature overrides:
# VITE_FEATURE_ONLINE=true
# VITE_FEATURE_RANKED=true
# VITE_FEATURE_DEBUG_TOOLS=true
# VITE_FEATURE_ONLINE_DIAGNOSTICS=true
# VITE_FEATURE_TRAINING_MODE=true
# VITE_FEATURE_ARCADE_MODE=true
# VITE_FEATURE_ONLINE_DEV_MENU=true
# VITE_FEATURE_ROLLBACK_SCAFFOLD=true
# Optional diagnostics export metadata:
# VITE_APP_BUILD=dev-local
# VITE_RULESET_VERSION=prototype-2026.02
